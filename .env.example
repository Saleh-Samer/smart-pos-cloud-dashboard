PORT=5000

# A long random string — must match CLOUD_SYNC_SECRET in the shop's local
# backend/.env exactly. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUSH_SECRET=generate_a_long_random_string_here

# A different long random string, used only to sign this dashboard's own
# login sessions. Do NOT reuse the shop's local JWT_SECRET here — this is a
# separate trust boundary. Generate the same way as PUSH_SECRET.
JWT_SECRET=generate_another_long_random_string_here

# bcrypt hash of the password you'll type into the dashboard's login page.
# Generate it once, after `npm install`, with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_CHOSEN_PASSWORD', 10))"
# Paste the printed $2a$... string here as-is (no quotes needed).
DASHBOARD_PASSWORD_HASH=

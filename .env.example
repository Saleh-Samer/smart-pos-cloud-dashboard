# ---- Smart POS Cloud — environment variables ----
# On Render: Dashboard → your service → Environment. Locally: copy to .env.

# PostgreSQL connection string (Neon → your project → Connect → copy the
# connection string, it starts with postgresql://). Keep it secret.
# For a quick local test with no database: DATABASE_URL=pg-mem
DATABASE_URL=

# Long random string used to sign sign-in sessions (32+ characters).
# On Render use the "Generate" button. Locally:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# bcrypt hash of YOUR owner password for /admin.html. Make it with:
#   node scripts/hash-password.js
ADMIN_PASSWORD_HASH=

# Optional: the site's public address, used inside connection codes.
# Defaults to the address the request came in on.
# PUBLIC_URL=https://smart-pos-cloud-dashboard.onrender.com
